# Copy to .env and adjust. .env is git-ignored.
APP_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=INFO
# Demo-only: enables GET /error which returns HTTP 500 (used to show an error spike).
ENABLE_ERROR_ENDPOINT=true

# Grafana admin credentials (required by docker-compose.monitoring.yml - no defaults on purpose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
